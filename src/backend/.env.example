# Backend Environment Variables
# Copy this file to .env and fill in actual values

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# DynamoDB Tables
DYNAMODB_TABLE_USERS=Users
DYNAMODB_TABLE_CATEGORIES=Categories
DYNAMODB_TABLE_TRANSACTIONS=Transactions
DYNAMODB_TABLE_REFRESH_TOKENS=RefreshTokens

# S3
S3_BUCKET_NAME=ledger-receipts-dev
# Optional S3-compatible storage overrides (e.g. LocalStack, MinIO)
# S3_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Logging
LOG_LEVEL=info
